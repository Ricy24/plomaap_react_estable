# Backend Django (API)
# En desarrollo el backend corre en http://localhost:5000
# En producción usa la URL pública del API o déjalo vacío si el frontend y el
# API se sirven detrás del mismo dominio con un proxy /api.
VITE_API_URL=http://localhost:5000

# Geocodificación de direcciones (Nominatim / OpenStreetMap)
VITE_GEOCODING_API=https://nominatim.openstreetmap.org/search

# Cloudinary (subida de imágenes)
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# Google OAuth 2.0
VITE_GOOGLE_CLIENT_ID=tu_google_client_id
